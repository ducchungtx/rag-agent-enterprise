APP_NAME=rag-agent-enterprise
DEBUG=true
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rag_enterprise
JWT_SECRET=dev-only-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REDIS_URL=redis://localhost:6379/0
USE_ASYNC_INGEST=false
DATA_DIR=./data/uploads

# --- Lab offline (mặc định) ---
EMBEDDING_DIM=384
EMBEDDING_PROVIDER=fake
CHAT_PROVIDER=fake
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
EMBEDDING_MODEL=nomic-embed-text
CHAT_MODEL=qwen2.5:7b

# --- Keys: giữ cùng lúc, chỉ đổi CHAT_PROVIDER (+ CHAT_MODEL) rồi restart ---
# MISTRAL_API_KEY=
# GEMINI_API_KEY=

# --- Mistral AI (chat) — docs/01-nen-tang/05-cau-hinh-mistral.md ---
# CHAT_PROVIDER=mistral
# EMBEDDING_PROVIDER=fake
# CHAT_MODEL=mistral-medium-latest
# CHAT_MODEL=ministral-8b-2512
# CHAT_MODEL=mistral-large-2512

# --- Gemini (OpenAI-compatible) — https://ai.google.dev/gemini-api/docs/models ---
# CHAT_PROVIDER=gemini
# EMBEDDING_PROVIDER=fake
# CHAT_MODEL=gemini-3.8-flash          # khuyến nghị (stable Flash mới)
# CHAT_MODEL=gemini-3.5-flash-lite     # rẻ / nhanh
# CHAT_MODEL=gemini-3.1-pro-preview    # câu khó
# CHAT_MODEL=gemini-2.5-flash          # chỉ nếu key còn quyền 2.5
# (base URL tự chọn; không cần sửa LLM_BASE_URL)

# --- Embed Mistral (dim 1024 — cần: make db-reset + restart API + re-ingest) ---
# EMBEDDING_PROVIDER=mistral
# EMBEDDING_DIM=1024
# EMBEDDING_MODEL=mistral-embed-2312
# CHAT_MODEL=ministral-8b-2512   # giữ RPS cao khi lab


# --- Frontend CORS + M6.0 relevance gate ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RETRIEVAL_MIN_SCORE=0.22
